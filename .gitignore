# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/

# Production build
/build
/dist

# Environment variables
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Ignore all .env files by default except example template
.env*
!.env.example

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# IDE & Editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript & Next.js cache
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
