# ==============================================================================
# A1 Mobile Shop — Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
# ==============================================================================

# MongoDB Atlas Database Connection (from https://cloud.mongodb.com)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/a1shop?retryWrites=true&w=majority"

# Cloudinary Image Upload (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Iron Session Secret (min 32 characters, secure random string)
# Tip: Generate via `openssl rand -hex 32`
SESSION_SECRET="a1mobileshop_super_secret_session_encryption_key_at_least_32_chars_long_123456"

# WhatsApp Business / Enquiry Settings
NEXT_PUBLIC_WHATSAPP_NUMBER="918726942338"
NEXT_PUBLIC_SITE_URL="https://a1mobileshop.in"

# Seed Credentials (used once when running `npm run seed`)
ADMIN_SEED_EMAIL="Jaikishanhome1998@gmail.com"
ADMIN_SEED_PASSWORD="Admin@123456"
